{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitsDisabled",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": [
    "dependencies"
  ],
  "hostRules": [
    {
      "matchHost": "https://codeberg.org",
      "concurrentRequestLimit": 2,
      "maxRequestsPerSecond": 2
    }
  ],
  "branchConcurrentLimit": 5,
  "prConcurrentLimit": 3,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the self-hosted Renovate runner version",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/renovate\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) packageName=(?<packageName>\\S+)\\s+MASH_RENOVATE_VERSION: '(?<currentValue>[^']+)'"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Roles use `vUPSTREAM-N` tags. `sourceUrl` is only known after lookup, so `matchSourceUrls` cannot select the versioning; match the datasource instead",
      "ignoreUnstable": false,
      "versioning": "loose",
      "matchDatasources": ["git-tags"],
      "matchSourceUrls": [
        "https://github.com{/,}**",
        "https://codeberg.org{/,}**"
      ]
    },
    {
      "description": "Automerge version bumps of roles maintained in the MASH organization and of devture roles (via branch push - no PR)",
      "matchManagers": ["ansible-galaxy"],
      "matchSourceUrls": [
        "https://github.com/devture/com.devture.ansible.role{/,}**",
        "https://github.com/mother-of-all-self-hosting{/,}**"
      ],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Automerge updates of the self-hosted Renovate runner (via branch push - no PR) monthly",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["mash-renovate-runner"],
      "allowedVersions": "!/^44\\.64\\.0$/",
      "automerge": true,
      "automergeType": "branch",
      "schedule": ["* 0-3 1 * *"],
      "automergeSchedule": ["* 0-3 1 * *"]
    }
  ],
  "github-actions": {
    "automerge": true,
    "automergeType": "branch"
  },
  "mise": {
    "automerge": true,
    "automergeType": "branch"
  },
  "pre-commit": {
    "enabled": true,
    "automerge": true,
    "automergeType": "branch",
    "schedule": ["* * * * 1"]
  }
}
