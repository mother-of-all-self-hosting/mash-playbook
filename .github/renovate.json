{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitsDisabled",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": [
    "dependencies"
  ],
  "hostRules": [
    {
      "matchHost": "https://codeberg.org",
      "concurrentRequestLimit": 2,
      "maxRequestsPerSecond": 2
    },
    {
      "matchHost": "iris.radicle.network",
      "enabled": false
    }
  ],
  "branchConcurrentLimit": 5,
  "prConcurrentLimit": 3,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the self-hosted Renovate runner version",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/renovate\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) packageName=(?<packageName>\\S+)\\s+MASH_RENOVATE_VERSION: '(?<currentValue>[^']+)'"
      ]
    },
    {
      "customType": "regex",
      "description": "Update the ghcr.io/devture/ansible image referenced in the documentation",
      "managerFilePatterns": [
        "/^docs\\/ansible\\.md$/"
      ],
      "matchStrings": [
        "ghcr\\.io\\/devture\\/ansible:(?<currentValue>[^\\s`]+)"
      ],
      "depNameTemplate": "ghcr.io/devture/ansible",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Roles use `vUPSTREAM-N` tags. `sourceUrl` is only known after lookup, so `matchSourceUrls` cannot select the versioning; match the datasource instead",
      "ignoreUnstable": false,
      "versioning": "loose",
      "matchDatasources": ["git-tags"]
    },
    {
      "description": "Automerge updates of the self-hosted Renovate runner (via branch push - no PR) monthly",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["mash-renovate-runner"],
      "allowedVersions": "!/^44\\.64\\.0$/",
      "automerge": true,
      "automergeType": "branch",
      "schedule": ["* 0-3 1 * *"],
      "automergeSchedule": ["* 0-3 1 * *"]
    },
    {
      "description": "Disable Git tag updates from iris.radicle.network",
      "matchDatasources": ["git-tags"],
      "matchSourceUrls": ["https://iris.radicle.network/**"],
      "enabled": false
    },
    {
      "description": "ghcr.io/devture/ansible is tagged `<Alpine ansible package version>-<release>` (e.g. `14.0.0-r0-3`). Docker versioning would consider `-r0-3` a compatibility suffix and never offer `-r0-4`",
      "matchDepNames": ["ghcr.io/devture/ansible"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-r(?<build>\\d+)-(?<revision>\\d+)$"
    }
  ],
  "github-actions": {
    "automerge": true,
    "automergeType": "branch"
  },
  "mise": {
    "automerge": true,
    "automergeType": "branch"
  },
  "pre-commit": {
    "enabled": true,
    "automerge": true,
    "automergeType": "branch",
    "schedule": ["* * * * 1"]
  }
}
