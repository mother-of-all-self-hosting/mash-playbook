PORT={{ ohrwurm_container_http_port }}
NODE_ENV=production

{% if ohrwurm_environment_audd_api_token %}
AUDD_API_TOKEN={{ ohrwurm_environment_audd_api_token }}
{% endif %}
{% if ohrwurm_environment_session_secret %}
SESSION_SECRET={{ ohrwurm_environment_session_secret }}
{% endif %}
{% if ohrwurm_environment_spotify_client_id %}
SPOTIFY_CLIENT_ID={{ ohrwurm_environment_spotify_client_id }}
{% endif %}
{% if ohrwurm_environment_spotify_client_secret %}
SPOTIFY_CLIENT_SECRET={{ ohrwurm_environment_spotify_client_secret }}
{% endif %}
{% if ohrwurm_hostname %}
SPOTIFY_REDIRECT_URI={{ ohrwurm_environment_spotify_redirect_uri }}
{% endif %}

{{ ohrwurm_environment_variables_additional_variables }}
